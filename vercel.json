{
    "version": 2,
    "builds": [
        { "src": "api/index.php", "use": "vercel-php@0.6.2" },
        { "src": "public/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "VIEW_COMPILED_PATH": "/tmp",
        "SESSION_DRIVER": "cookie",
        "LOG_CHANNEL": "stderr",
        "CACHE_STORE": "array"
    }
}